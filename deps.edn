{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure           {:mvn/version "1.12.1"}

  ;; Result monad, ADT, lifecycle
  io.github.hive-agi/hive-dsl   {:mvn/version "0.5.25"}

  ;; bounded-pmap for parallel file scanning
  io.github.hive-agi/hive-weave {:mvn/version "0.3.10"}

  ;; TOML parser for gitleaks rules
  org.tomlj/tomlj               {:mvn/version "1.1.1"}

  ;; CLI parsing
  org.clojure/tools.cli         {:mvn/version "1.1.230"}

  ;; Data specs
  metosin/malli                 {:mvn/version "0.17.0"}

  ;; JSON output
  cheshire/cheshire             {:mvn/version "6.2.0"}

  ;; Logging
  com.taoensso/timbre           {:mvn/version "6.8.0"}}

 :aliases
 {:dev
  {:extra-paths ["dev" "test"]
   :extra-deps  {nrepl/nrepl                   {:mvn/version "1.6.0"}
                 cider/cider-nrepl              {:mvn/version "0.58.0"}
                 io.github.hive-agi/hive-test   {:mvn/version "0.4.5"}
                 org.clojure/test.check         {:mvn/version "1.1.3"}}}

  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 io.github.hive-agi/hive-test   {:mvn/version "0.4.5"}
                 org.clojure/test.check         {:mvn/version "1.1.3"}}
   :main-opts   ["-m" "cognitect.test-runner"]}

  :nrepl
  {:extra-paths ["dev" "test"]
   :extra-deps  {nrepl/nrepl        {:mvn/version "1.6.0"}
                 cider/cider-nrepl  {:mvn/version "0.58.0"}}
   :main-opts   ["-m" "nrepl.cmdline"
                 "--port" "7920"
                 "--middleware" "[cider.nrepl/cider-middleware]"]}

  :build
  {:deps       {io.github.hive-agi/hive-build {:mvn/version "0.1.15"}}
   :jvm-opts   ["-Xmx1g"]
   :ns-default hive-build.api}}}
